<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <StageRoot Condition="'$(StageRoot)' == ''">$(MSBuildThisFileDirectory)out\$(Configuration)</StageRoot>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)out\.packages</RestorePackagesPath>
    <RestoreAdditionalProjectSources Condition="'$(SdkFeed)' != ''">$(SdkFeed);$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
